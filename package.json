{
  "name": "humanuml",
  "version": "0.1.0",
  "private": true,
  "description": "HumanUML deterministic Controlled English requirements compiler",
 

  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "humanuml": "tsx apps/cli/src/index.ts",
    "build": "tsup --config tsup.config.mts",
    "build:check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "humanuml:built": "node apps/cli/dist/index.mjs"
  },


  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
